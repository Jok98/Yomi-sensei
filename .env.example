# Opzioni da impostare nell'ambiente: questo file non viene caricato automaticamente.
# Nessuna API key: la chat usa Codex CLI con login ChatGPT locale.
CODEX_EXECUTABLE=
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120
STOCKFISH_PATH=
STOCKFISH_DEPTH=16
# Interprete solo per lo sviluppo; il pacchetto usa il backend incorporato.
YOMI_PYTHON=
# Runtime Maia separato; il pacchetto incorpora il worker e i pesi.
MAIA_RUNTIME_DIR=
MAIA_PYTHON_PATH=
MAIA_WORKER_PATH=
MAIA_DEVICE=auto
MAIA_THREADS=4
